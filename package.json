{
  "name": "avatar-motion-skill",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Create cursor-responsive avatars in the bundled warm cartoon illustration style, with Framer and HTML exports.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "demo": "node skills/avatar-motion/scripts/build.mjs --image skills/avatar-motion/references/style-reference.png --rig skills/avatar-motion/assets/demo.rig.json --out demo-output --name \"Avatar Motion\"",
    "preview": "node skills/avatar-motion/scripts/serve.mjs demo-output"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/react": "^19.2.0"
  }
}
